<?xml version="1.0" encoding="UTF-8"?>
<ivy-module version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://ant.apache.org/ivy/schemas/ivy.xsd"
>


    <info organisation="bugtamer" module="areca-plugin-as3"/>


    <configurations>
        <conf name="plugin-specific"         description="Required by areca-plugin-as3.jar" />
        <conf name="platform-agnostic"       description="Required by areca.jar" />
        <conf name="platform-windows-x86-64" description="Required by GUI (plugin or areca.jar)" />
        <conf name="platform-linux-x86-64"   description="Required by GUI (plugin or areca.jar)" />
    </configurations>


    <dependencies>

        <!-- Plugin Specific -->

        <dependency conf="plugin-specific -> default" org="commons-httpclient"       name="commons-httpclient" rev="3.1"/>
        <dependency conf="plugin-specific -> default" org="commons-logging"          name="commons-logging"    rev="1.3.5"/>
        <dependency conf="plugin-specific -> default" org="org.apache.mahout.jets3t" name="jets3t"             rev="0.6.1" />

        <!-- Platform Agnostic -->

        <dependency conf="platform-agnostic -> default" org="org.eclipse.jface" name="org.eclipse.jface" rev="3.2.0-I20060605-1400" />

        <!-- Platform Specific -->
        
        <dependency conf="platform-windows-x86-64 -> default" org="org.eclipse.swt" name="org.eclipse.swt.win32.win32.x86_64" rev="4.3" />
        <dependency conf="platform-linux-x86-64   -> default" org="org.eclipse.swt" name="org.eclipse.swt.gtk.linux.x86_64"   rev="4.3" />

    </dependencies>


</ivy-module>